# ============================================================================
# AutoFigure local defaults
# Used by both `python server.py` and `python autofigure2.py`
# Explicit CLI args / Web form values still take precedence
# ============================================================================

AUTOFIGURE_PROVIDER=gemini
AUTOFIGURE_BASE_URL=
AUTOFIGURE_IMAGE_MODEL=
AUTOFIGURE_SVG_MODEL=
AUTOFIGURE_IMAGE_SIZE=4K

AUTOFIGURE_SAM_BACKEND=roboflow
AUTOFIGURE_SAM_PROMPT=icon,person,robot,animal
AUTOFIGURE_MIN_SCORE=0.0
AUTOFIGURE_SAM_MAX_MASKS=32
AUTOFIGURE_PLACEHOLDER_MODE=label
AUTOFIGURE_MERGE_THRESHOLD=0.9
AUTOFIGURE_OPTIMIZE_ITERATIONS=0

# Optional generic key for the default provider
AUTOFIGURE_API_KEY=

# Provider-specific keys
OPENROUTER_API_KEY=
BIANXIE_API_KEY=
GEMINI_API_KEY=
ARK_API_KEY=

# Optional SAM API keys
ROBOFLOW_API_KEY=
FAL_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com/sam3/concept_segment
ROBOFLOW_API_FALLBACK_URLS=

# Required for RMBG-2.0 (gated HuggingFace model)
# 1) Request access at https://huggingface.co/briaai/RMBG-2.0
# 2) Create a Read token and set it below
HF_TOKEN=

# Optional: OpenRouter multimodal retry tuning (step 4 SVG generation)
# OPENROUTER_MULTIMODAL_RETRIES=3
# OPENROUTER_MULTIMODAL_RETRY_DELAY=1.5

# Optional: SAM API retry tuning
# SAM3_API_RETRIES=3
# SAM3_API_RETRY_DELAY=1.5

# Optional build source overrides (for restricted networks)
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_EXTRA_INDEX_URL=

# Optional container DNS override (for Roboflow DNS resolution issues)
# DOCKER_DNS_1=223.5.5.5
# DOCKER_DNS_2=119.29.29.29
